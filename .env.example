# Staff Calculator, and Weekly Training Builder work 100% offline without these keys.

# Google Gemini API (@google/genai >= 3.2.0 — Server-Only)
GEMINI_API_KEY=""

# Supabase Cloud (Postgres + pgvector + RLS + Storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
