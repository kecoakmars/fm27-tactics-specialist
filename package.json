{
  "name": "fm27-tactics-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/listiantohefiredfsen-debug/fm27-tactics-generator-specialist.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit",
    "lint": "pnpm -r run lint",
    "test": "vitest run --reporter=dot",
    "data:extract": "node scripts/extract-legacy-data.mjs",
    "data:validate": "tsx scripts/validate-data.mjs",
    "data:new-patch": "node scripts/new-patch-version.mjs",
    "data:fixtures": "tsx scripts/generate-golden-fixtures.mjs",
    "db:seed": "node scripts/seed-db.mjs",
    "generate:seed": "tsx scripts/generate-seed-from-save.ts",
    "worker:build": "node scripts/build-save-worker.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "zod": "^3.24.2"
  }
}
